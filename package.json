{
  "name": "institutional-trading-sdet-lab",
  "version": "1.0.0",
  "private": true,
  "description": "TradeFlow: synthetic institutional-trading SDET lab with Playwright and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:ui": "esbuild app/public/app.ts --bundle --format=esm --target=es2022 --outfile=app/public/app.js",
    "build": "tsx scripts/build.ts",
    "start": "npm run build:ui && tsx app/server/index.ts",
    "start:production": "node dist/app/server/index.js",
    "smoke:production": "tsx scripts/verify-production.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "contract:validate": "tsx scripts/validate-openapi.ts",
    "workflow:validate": "tsx scripts/validate-workflow.ts && tsx scripts/validate-database-contract.ts",
    "browsers:install": "playwright install chromium firefox webkit",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=service tests/api",
    "test:contract": "playwright test --project=service tests/contract",
    "test:integration": "playwright test tests/integration",
    "demo:failure": "playwright test --config=playwright.demo.config.ts --grep-invert contract",
    "demo:contract": "playwright test --config=playwright.demo.config.ts --grep contract",
    "report": "playwright show-report playwright-report",
    "report:demo": "playwright show-report demo-report",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "validate": "npm audit && npm audit --omit=dev && npm run typecheck && npm run lint && npm run format:check && npm run contract:validate && npm run workflow:validate && npm run test:unit && npm run test:financial && npm run build && npm run smoke:production && npm test",
    "test:financial": "tsx scripts/verify-financial.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "test:workflow-browser": "node --import tsx scripts/test-workflow-browser.ts",
    "validate:all": "npm run validate && npm test -- --repeat-each=2 && npm run test:postgres && npm run test:postgres && npm run build:ui && npm run test:workflow-browser && npm run test:workflow-browser -- --repeat-each=2",
    "db:local": "node --import tsx scripts/workflow-local.ts",
    "sandbox:client": "node --import tsx scripts/sandbox-client.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  }
}
